# Database & Authentication (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth (for Supabase Auth → Google Provider)
# Configure at: https://supabase.com/dashboard/project/_/auth/providers

# DigiLocker OAuth 2.0
# Register at: https://api.digitallocker.gov.in/register
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/auth/digilocker

# AI Engine — OCR & LLM Fallback
NEXT_PUBLIC_AI_PROVIDER=mock
# Options: google_gemini | openai | mock
# When set to "mock", no API keys are required and simulated OCR runs locally.

GEMINI_API_KEY=
OPENAI_API_KEY=

# Feature Flags
NEXT_PUBLIC_ENABLE_REAL_AI_OCR=false
NEXT_PUBLIC_MAX_FILE_SIZE_MB=5
NEXT_PUBLIC_MIN_OCR_CONFIDENCE=85
